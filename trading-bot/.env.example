# --- Market data + live execution (OANDA) ---
# Practice account is free: https://www.oanda.com/demo-account/
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice          # practice | live

# --- AI analysis (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Bot behaviour ---
BOT_MODE=paper              # paper | live   (live also needs LIVE_TRADING_CONFIRM)
LIVE_TRADING_CONFIRM=       # must equal: I-ACCEPT-THE-RISK   to allow live orders
PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,XAU_USD
TIMEFRAME=H1                # M15 | H1 | H4
MIN_SCORE=3.0               # minimum confluence score to emit a signal
RISK_PER_TRADE=0.005        # 0.5% of equity per trade
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=0.02         # stop trading for the day at -2% equity
START_BALANCE=10000
