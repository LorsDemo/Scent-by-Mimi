# --- Market data ---
# DATA_PROVIDER: auto (default: first one configured) | twelvedata | oanda | synthetic
DATA_PROVIDER=auto
# Free key, no broker account needed: https://twelvedata.com (free plan ~8 requests/min, 800/day)
TWELVEDATA_API_KEY=

# --- OANDA (optional alternative data source, only if your country is supported) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# --- AI analysis (optional; the bot works without it) ---
# AI_PROVIDER: anthropic (Claude) | openai | gemini | ollama (free, local) | none
AI_PROVIDER=anthropic
AI_API_KEY=                 # not needed for ollama or none
AI_MODEL=                   # blank = sensible default; set it if a default model is retired
AI_BASE_URL=                # blank = provider default (ollama: http://localhost:11434/v1)
# Legacy names ANTHROPIC_API_KEY / CLAUDE_MODEL still work for the anthropic provider.

# --- Signals ---
PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,XAU_USD
TIMEFRAME=H1                # M15 | H1 | H4
MIN_SCORE=3.0               # minimum confluence score to emit a signal (higher = fewer, stronger signals)
RISK_PER_TRADE=0.005        # only used to express backtest results
START_BALANCE=10000         # only used to express backtest results

# --- Remote access (Android app) ---
API_TOKEN=                  # long random secret; required if HOST is not 127.0.0.1
HOST=127.0.0.1              # use 0.0.0.0 only behind HTTPS + API_TOKEN
